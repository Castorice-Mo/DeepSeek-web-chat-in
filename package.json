{
  "name": "@castorice-mo/chat-in-dsh",
  "version": "2.0.0-dshw.1",
  "type": "module",
  "description": "在 DeepSeek Harness 里嵌一个 DeepSeek 网页版面板（本地分叉）：走自己的网页账号额度、回答实时进 mneme 记忆库、自动接入账号历史、外观跟随宿主壁纸。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Castorice-Mo/DeepSeek-web-chat-in.git"
  },
  "homepage": "https://github.com/Castorice-Mo/DeepSeek-web-chat-in#readme",
  "bugs": {
    "url": "https://github.com/Castorice-Mo/DeepSeek-web-chat-in/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "chat",
    "chat-ui",
    "webview",
    "web-quota",
    "history-import",
    "wallpaper"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src",
    "webview/dist",
    "webview/brand-mark.svg",
    "locale",
    "icon.svg",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=22.12",
    "dsh": ">=0.1.7-alpha.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-alpha.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "author": "Castorice-Mo",
  "scripts": {
    "fetch:webview": "node scripts/fetch-webview.mjs"
  }
}
